#!/usr/bin/env bash
# Only mark a portable DEB usable after its producer has completed successfully.
set -euo pipefail
directory=${1:?Pass the portable artifact directory}
shopt -s nullglob
packages=("$directory"/kasmvncserver_*.deb)
[[ ${#packages[@]} == 1 ]] || { echo 'Expected exactly one portable KasmVNC package' >&2; exit 1; }
printf '%s\n' "$CI_PIPELINE_ID" "$CI_COMMIT_SHA" "$CI_JOB_ID" \
  "$(dpkg-deb -f "${packages[0]}" Architecture)" \
  "$(sha256sum "${packages[0]}" | cut -d ' ' -f 1)" \
  > "$directory/workspace-package.txt"
