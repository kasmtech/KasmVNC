#!/usr/bin/env bash
# Verify the published closure itself, without the development/test-tools closure.
set -euo pipefail
cd "$(dirname "$0")/.."
artifact_dir=${1:?Usage: builder/test-nix-smoke ARTIFACT_DIRECTORY}
artifact_dir=$(realpath "$artifact_dir")
shopt -s nullglob
paths=("$artifact_dir"/*.store-path)
[ "${#paths[@]}" = 1 ] || { echo 'Expected one package store-path' >&2; exit 1; }
package=$(cat "${paths[0]}")
[[ "$package" =~ ^/nix/store/[a-z0-9]{32}-kasmvnc-[a-zA-Z0-9.+-]+$ ]] || exit 1
archive=${paths[0]%.store-path}.tar.xz
scratch=$(mktemp -d)
container=
image="kasmvnc-nix-smoke:$$"
cleanup() {
  [ -z "$container" ] || docker rm -f "$container" >/dev/null
  docker image rm "$image" >/dev/null 2>&1 || true
  chmod -R u+w "$scratch"
  rm -rf "$scratch"
}
trap cleanup EXIT
(cd "$artifact_dir"; sha256sum -c "$(basename "${paths[0]%.store-path}.sha256")")
cp "$archive" "$scratch/runtime.tar.xz"
for base in ubuntu:24.04 alpine:3.23; do
  printf 'FROM %s\nADD runtime.tar.xz /\n' "$base" > "$scratch/Dockerfile"
  docker build -t "$image" "$scratch"
  docker run --rm --runtime=runc --entrypoint "$package/bin/Xvnc" "$image" -version
  container=$(docker run -d --runtime=runc \
    -p "${NIX_TEST_BIND_IP:-127.0.0.1}::6901" --entrypoint "$package/bin/Xvnc" "$image" \
    :1 -interface 0.0.0.0 -PublicIP 127.0.0.1 -disableBasicAuth -SecurityTypes None -sslOnly 0 \
    -httpd "$package/share/kasmvnc/www" -websocketPort 6901)
  port=$(docker port "$container" 6901/tcp | sed 's/.*://')
  curl -fsS --retry 20 --retry-delay 1 --retry-connrefused --retry-all-errors "http://${NIX_TEST_DOCKER_HOST:-127.0.0.1}:$port/" -o "$scratch/index.html"
  test -s "$scratch/index.html"
  docker logs "$container"
  docker rm -f "$container" >/dev/null
  container=
  echo "Nix closure smoke passed: $base"
done
