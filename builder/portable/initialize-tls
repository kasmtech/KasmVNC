#!/bin/sh
# Used by the RPM and by administrators installing the portable tar archive.
set -eu
cert=/etc/pki/tls/private/kasmvnc.pem
getent group kasmvnc-cert >/dev/null || groupadd --system kasmvnc-cert
if [ -L "$cert" ] && [ ! -e "$cert" ]; then
    echo "initialize-tls: $cert is a broken symlink to $(readlink "$cert"); leaving it unchanged" >&2
fi
if [ ! -e "$cert" ] && [ ! -L "$cert" ]; then
    install -d -m 755 /etc/pki/tls/private
    umask 077
    tmp=$(mktemp "$cert.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    trap 'exit 1' HUP INT TERM
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
        -keyout "$tmp" -out "$tmp" -subj /CN=KasmVNC
    openssl x509 -in "$tmp" -noout
    openssl pkey -in "$tmp" -noout
    chgrp kasmvnc-cert "$tmp"
    chmod 640 "$tmp"
    mv -f "$tmp" "$cert"
    trap - EXIT HUP INT TERM
fi
