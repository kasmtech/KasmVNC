ARG SPEC_BASE_IMAGE
FROM ${SPEC_BASE_IMAGE}

USER root

ARG KASMVNC_PACKAGE_DIR
COPY $KASMVNC_PACKAGE_DIR/kasmvncserver_*.deb /tmp/
RUN apt-get update && apt-get install -y /tmp/*$(dpkg --print-architecture).deb

ENV USER docker
ENV HOME /home/docker

RUN chown -R 1000:0 $HOME
USER 1000:ssl-cert
WORKDIR $HOME

ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

ENTRYPOINT ["/bin/bash", "-ic", "/src/builder/run-specs-inside-docker"]
