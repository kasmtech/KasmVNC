#!/usr/bin/env bash
# Experimental native x86_64/aarch64 EL9 profile; use a clean build tree.
set -eo pipefail
source /opt/rh/gcc-toolset-14/enable
set -u
[[ $(getconf GNU_LIBC_VERSION) == 'glibc 2.34' ]] || {
    echo "This profile requires a clean EL9 / glibc 2.34 builder" >&2; exit 1;
}
case $(uname -m) in
    x86_64) baseline_flags='-march=x86-64 -mtune=generic' ;;
    aarch64) baseline_flags='-march=armv8-a -mtune=generic' ;;
    *) echo "This profile supports native x86_64 and aarch64 builders" >&2; exit 1 ;;
esac
# Apply the baseline to every source-built archive, including private libgcc.
# EL9's packaged x86 archives may still require x86-64-v2.
export CFLAGS="-O2 -fPIC $baseline_flags ${CFLAGS:-}"
export CXXFLAGS="-O2 -fPIC $baseline_flags ${CXXFLAGS:-}"
export KASMVNC_GCC_RUNTIME_PREFIX=${KASMVNC_GCC_RUNTIME_PREFIX:-/opt/kasm-gcc-runtime}
if [[ ${KASMVNC_PREBUILT_DEPENDENCIES:-0} != 1 ]]; then
/src/builder/scripts/build-static-gcc-runtime
else
    test "$(cat /opt/kasm-dependencies-ready)" = kasmvnc-portable-dependencies-v1
fi
export KASMVNC_NATIVE_LAUNCHER=ON
export XORG_VER=21.1.25
export KASMVNC_BUILD_OS=oracle KASMVNC_BUILD_OS_CODENAME=9
export KASMVNC_STATIC_DESKTOP_PREFIX=${KASMVNC_STATIC_DESKTOP_PREFIX:-/opt/kasm-desktop}
/src/builder/build-static-inside-docker "$@"
/src/builder/scripts/check-glibc-floor --maximum 2.34 \
    /src/unix/xserver/hw/vnc/Xvnc /src/unix/kasmvncpasswd/kasmvncpasswd
