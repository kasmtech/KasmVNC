#!/usr/bin/env bash
# Run only inside a build/test container. Outputs are kept outside the checkout.
set -euo pipefail
source_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
build_dir=${1:?Usage: builder/openssl-tests/build OUTPUT_DIRECTORY}
mkdir -p "$build_dir"
# CPPFLAGS/LDFLAGS allow selecting the pinned OpenSSL baseline in portable builders.
read -r -a cppflags <<< "${CPPFLAGS:-}"
read -r -a cxxflags <<< "${CXXFLAGS:--O2 -g}"
read -r -a ldflags <<< "${LDFLAGS:-}"
sources=("$source_dir/builder/openssl-tests/crypto-regression.cxx")
for source in "$source_dir"/common/network/webudp/*.cpp; do
  case "$source" in */Wu.cpp|*/WuHostEpoll.cpp|*/WuHostNull.cpp|*/WuNetwork.cpp) continue;; esac
  sources+=("$source")
done
wrappers=(EVP_PKEY_CTX_new_id EVP_PKEY_keygen_init EVP_PKEY_keygen X509_new BN_new BN_rand BN_to_ASN1_INTEGER X509_sign X509_digest)
for symbol in "${wrappers[@]}"; do ldflags+=("-Wl,--wrap=$symbol"); done
"${CXX:-c++}" -std=c++20 -I"$source_dir/common" "${cppflags[@]}" "${cxxflags[@]}" \
  "${sources[@]}" "${ldflags[@]}" -lssl -lcrypto -o "$build_dir/crypto-regression"
