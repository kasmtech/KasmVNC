#!/usr/bin/env bash
set -euo pipefail
export KASMVNC_LIBC=musl
[[ $(/lib/ld-musl-*.so.1 2>&1 || :) == *'Version 1.2.5'* ]] || {
    echo 'This profile requires the Alpine 3.21 / musl 1.2.5 builder' >&2; exit 1;
}
case $(uname -m) in
 x86_64) baseline='-march=x86-64 -mtune=generic' ;;
 aarch64) baseline='-march=armv8-a -mtune=generic' ;;
 *) exit 1 ;;
esac
export CFLAGS="-O2 -fPIC $baseline ${CFLAGS:-}"
export CXXFLAGS="-O2 -fPIC $baseline ${CXXFLAGS:-}"
export KASMVNC_DEPENDENCIES_MARKER=kasmvnc-portable-musl-dependencies-v1
export XORG_VER=21.1.25
export KASMVNC_BUILD_OS=alpine KASMVNC_BUILD_OS_CODENAME=321
export KASMVNC_STATIC_DESKTOP_PREFIX=${KASMVNC_STATIC_DESKTOP_PREFIX:-/opt/kasm-desktop}
exec /src/builder/build-static-inside-docker "$@"
