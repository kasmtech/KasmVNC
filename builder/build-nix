#!/usr/bin/env bash
# Build on the native Docker architecture, reusing the pipeline's www artifact.
set -euo pipefail
cd "$(dirname "$0")/.."
test -s builder/www/index.html || { echo 'Run builder/build-www first' >&2; exit 1; }
revision=${KASMVNC_COMMIT_ID:-$(git rev-parse HEAD)}
branch=${CI_COMMIT_REF_NAME:-$(git branch --show-current)}
version=${KASMVNC_NIX_VERSION:-$(.ci/next_release_version "$branch")}
test -n "$version" || { echo 'No release tags: fetch tags or set KASMVNC_NIX_VERSION' >&2; exit 1; }
case $(docker info --format '{{.Architecture}}') in
  x86_64|amd64) arch=x86_64-linux ;;
  aarch64|arm64) arch=aarch64-linux ;;
  *) echo 'Unsupported Docker architecture' >&2; exit 1 ;;
esac
case "$branch" in
  release/*) basename="kasmvncserver_nix_${version}_${arch}" ;;
  *) basename="kasmvncserver_nix_${version}_${branch//\//_}_${revision:0:6}_${arch}" ;;
esac
# Reject unsafe filename input before passing it to the container/export scripts.
[[ "$basename" =~ ^[a-zA-Z0-9_.+-]+$ ]] || { echo 'Unsafe artifact filename' >&2; exit 1; }
image="kasmvnc-nix-build:${revision:0:12}-${arch}"
docker build -f builder/dockerfile.nix -t "$image" \
  --build-arg KASMVNC_NIX_VERSION="$version" \
  --build-arg KASMVNC_COMMIT_ID="$revision" \
  --build-arg KASMVNC_NIX_BASENAME="$basename" \
  --build-arg NIX_BUILD_CORES="${NIX_BUILD_CORES:-4}" .
container=$(docker create "$image")
trap 'docker rm "$container" >/dev/null' EXIT
mkdir -p "builder/build/nix_${arch}"
docker cp "$container:/artifacts/." "builder/build/nix_${arch}/"
