FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND noninteractive

ARG DISTRO_MIRROR=
RUN if [ -n "$DISTRO_MIRROR" ]; then \
      find /etc/apt/sources.list.d/ -name "*.sources" -exec \
        sed -i "s@^URIs:.*@URIs: ${DISTRO_MIRROR}@" {} \; ; \
    fi

# Refresh the package index once; the installs below reuse it.
RUN apt-get update -o APT::Update::Error-Mode=any || { echo >&2 "APT mirror failed: apt-get update couldn't reach ${DISTRO_MIRROR:-the stock mirror}. Rerun with another KALI_MIRROR (GitLab) or DISTRO_MIRROR (local)."; exit 1; }

RUN apt-get -y install vim build-essential devscripts equivs

# Install build-deps for the package.
COPY ./debian/control /tmp
RUN echo YYY | mk-build-deps --install --remove /tmp/control

ENV SCRIPTS_DIR=/tmp/scripts
COPY builder/scripts $SCRIPTS_DIR

ARG OUTPUT_OWNER_UID
RUN $SCRIPTS_DIR/add-docker-user "$OUTPUT_OWNER_UID"
