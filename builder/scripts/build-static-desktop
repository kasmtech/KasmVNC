#!/usr/bin/env bash
# Experimental Noble desktop archive additions. Other archives come from the
# builder's matching development packages; see STATIC_BUILD.md for inventory.
set -euo pipefail
prefix=${KASMVNC_STATIC_DESKTOP_PREFIX:-/opt/kasm-desktop}
source_dir=${KASMVNC_DESKTOP_SOURCES:-/tmp/static-desktop-sources}
jobs=${BUILD_JOBS:-8}
export CFLAGS="${CFLAGS:-} -O2 -fPIC"
export CXXFLAGS="${CXXFLAGS:-} -O2 -fPIC"
meson_setup() {
    local build=$1
    shift
    local args=()
    [[ ! -f "$build/meson-private/coredata.dat" ]] || args+=(--reconfigure)
    meson setup "${args[@]}" "$build" "$@"
}
script_dir=$(cd "$(dirname "$0")" && pwd)
el9=false
if [[ -f /etc/redhat-release ]] && grep -q 'release 9\.' /etc/redhat-release; then
    el9=true
    "$script_dir/build-static-desktop-el9"
    export PKG_CONFIG_PATH="$prefix/lib/pkgconfig:$prefix/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    export CPPFLAGS="-I$prefix/include ${CPPFLAGS:-}"
    export LDFLAGS="-L$prefix/lib ${LDFLAGS:-}"
fi
mkdir -p "$source_dir" "$prefix/lib"
cd "$source_dir"
fetch() {
    local file=$1 url=$2 sha=$3
    [[ -f $file ]] || curl -fL --retry 3 "$url" -o "$file"
    echo "$sha  $file" | sha256sum -c -
    tar -xf "$file"
}
# Use the installed AT-SPI headers/pkg-config closure only with matching source.
if ! "$el9" && [[ $(pkg-config --modversion atspi-2) != 2.52.0 ]]; then
    echo "This prototype requires matching AT-SPI 2.52.0 development headers" >&2
    exit 1
fi
fetch at-spi2-core-2.52.0.tar.xz \
    https://download.gnome.org/sources/at-spi2-core/2.52/at-spi2-core-2.52.0.tar.xz \
    0ac3fc8320c8d01fa147c272ba7fa03806389c6b03d3c406d0823e30e35ff5ab
fetch libva-2.20.0.tar.bz2 \
    https://github.com/intel/libva/releases/download/2.20.0/libva-2.20.0.tar.bz2 \
    f72bdb4f48dfe71ad01f1cbefe069672a2c949a6abd51cf3c4d4784210badc49
meson_setup atspi-build at-spi2-core-2.52.0 \
    --default-library=static --prefix="$prefix" --libdir=lib \
    -Dintrospection=disabled -Ddocs=false -Dgtk2_atk_adaptor=false \
    -Duse_systemd=false -Dx11=enabled
# dbind sources are included in this archive. Do not build/install replacement
# host accessibility daemons or adapters.
ninja -C atspi-build -j"$jobs" atspi/libatspi.a
cp atspi-build/atspi/libatspi.a "$prefix/lib/"
if "$el9"; then
    # The client and headers must match, without installing host daemons.
    mkdir -p "$prefix/include/at-spi-2.0/atspi" "$prefix/lib/pkgconfig"
    cp at-spi2-core-2.52.0/atspi/*.h atspi-build/atspi/*.h "$prefix/include/at-spi-2.0/atspi/"
    cp atspi-build/meson-private/atspi-2.pc "$prefix/lib/pkgconfig/"
    # Old Meson leaks dbind's internal logging define into consumer flags;
    # make/shell quoting then turns its string into an undeclared identifier.
    sed -i 's/ -DG_LOG_DOMAIN="dbind"//g' "$prefix/lib/pkgconfig/atspi-2.pc"
fi
(
    cd libva-2.20.0
    # Keep vendor drivers external, with the host's normal multiarch path.
    host_libdir=$(pkg-config --variable=libdir libdrm)
    if "$el9"; then host_libdir=/usr/lib64; fi
    ./configure --prefix="$prefix" --libdir="$prefix/lib" \
        --enable-static --disable-shared --enable-drm \
        --disable-x11 --disable-glx --disable-wayland \
        --with-drivers-path="${KASMVNC_PORTABLE_DRIVER_PATH:-$host_libdir/dri}"
    make -j"$jobs"
    make install
)

# Preserve GIO mount support. EL9's patched GLib requires the libmount 2.40
# mnt_monitor_veil_kernel API even though its distro version is still 2.37.
util_linux_version=2.39.3
util_linux_sha=7b6605e48d1a49f43cc4b4cfc59f313d0dd5402fa40b96810bd572e167dfed0f
if "$el9"; then
    util_linux_version=2.42.4
    util_linux_sha=fbd62a100ab7bb8746ba0661255c3c48185b1e9021507c624da01fbc696330ec
fi
fetch "util-linux-$util_linux_version.tar.xz" \
    "https://www.kernel.org/pub/linux/utils/util-linux/v${util_linux_version%.*}/util-linux-$util_linux_version.tar.xz" \
    "$util_linux_sha"
(
    cd "util-linux-$util_linux_version"
    ./configure --prefix="$prefix" --libdir="$prefix/lib" \
        --disable-all-programs --enable-libmount --enable-libblkid \
        --enable-libuuid --enable-static --disable-shared \
        --without-python --without-systemd --disable-bash-completion
    make -j"$jobs" libmount.la libblkid.la libuuid.la
    cp .libs/libmount.a "$prefix/lib/"
    if "$el9"; then
        cp .libs/libblkid.a .libs/libuuid.a "$prefix/lib/"
    fi
)

# Rebuild PIC to retain server ASLR/PIE. Stable 1.8.3 includes upstream
# AArch64 context-type fixes (PR #524) required by GCC 14; do not suppress
# incompatible-pointer diagnostics or cast away the context mismatch.
fetch libunwind-1.8.3.tar.gz \
    https://github.com/libunwind/libunwind/releases/download/v1.8.3/libunwind-1.8.3.tar.gz \
    be30d910e67f58d82e753231f1357f326a1a088acf126b21ff77e60aab19b90b
(
    cd libunwind-1.8.3
    CFLAGS="${CFLAGS:-} -O2 -fPIC -fstack-protector-strong" ./configure \
        --prefix="$prefix" --libdir="$prefix/lib" \
        --enable-static --disable-shared --with-pic \
        --disable-tests --disable-documentation
    make -j"$jobs"
    make install
)
