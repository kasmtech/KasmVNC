#!/usr/bin/env bash

set -ex pipefail

LIBYUV_REPO="https://chromium.googlesource.com/libyuv/libyuv"
LIBYUV_SRC_DIR="/tmp/libyuv"

prepare_source() {
  [ -d "$LIBYUV_SRC_DIR" ] && rm -rf "$LIBYUV_SRC_DIR"

  if [[ -n ${LIBYUV_COMMIT:-} ]]; then
    git init "$LIBYUV_SRC_DIR"
    git -C "$LIBYUV_SRC_DIR" remote add origin "$LIBYUV_REPO"
    timeout -k 10 180 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 -C "$LIBYUV_SRC_DIR" fetch --depth 1 origin "$LIBYUV_COMMIT"
    git -C "$LIBYUV_SRC_DIR" checkout --detach FETCH_HEAD
    test "$(git -C "$LIBYUV_SRC_DIR" rev-parse HEAD)" = "$LIBYUV_COMMIT"
  else
    git clone --branch "${LIBYUV_BRANCH:-stable}" --depth 1 "$LIBYUV_REPO" "$LIBYUV_SRC_DIR"
  fi

  cd "$LIBYUV_SRC_DIR"
}

build_and_install() {
  export MAKEFLAGS=-j$(nproc)

  # Disable problematic NEON64 assembly for ARM64
  if [ "$(uname -m)" = "aarch64" ]; then
    EXTRA_CXXFLAGS="-DLIBYUV_DISABLE_NEON"
  else
    EXTRA_CXXFLAGS=""
  fi

  cp -r include/ "$HOME/.local/"
  make V=1 -f linux.mk CFLAGS="-O2 -fomit-frame-pointer -fPIC -Iinclude/" CXXFLAGS="-O2 -fomit-frame-pointer -fPIC -Iinclude/ $EXTRA_CXXFLAGS"

  install -D -m 0644 libyuv.a "$HOME/.local/lib/libyuv.a"
}

prepare_source
build_and_install
