#!/usr/bin/env bash
# Build application dependencies in an isolated prefix inside a build container.
set -euo pipefail
recipe_dir=$(cd "$(dirname "$0")" && pwd)
prefix=${KASMVNC_STATIC_RUNTIME_PREFIX:-/opt/kasm-runtime}
source_dir=${KASMVNC_RUNTIME_SOURCES:-/tmp/static-sources}
jobs=${BUILD_JOBS:-8}
mkdir -p "$source_dir"
cd "$source_dir"
fetch_tar() {
    local file=$1 url=$2 sha=$3
    [[ -f $file ]] || curl --connect-timeout 30 --max-time 900 -fL --retry 3 "$url" -o "$file"
    echo "$sha  $file" | sha256sum -c -
    tar -xf "$file"
}
fetch_git() {
    local name=$1 url=$2 revision=$3
    if [[ ! -d $name/.git ]]; then
        git init "$name"
        git -C "$name" remote add origin "$url"
        timeout -k 10 180 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 -C "$name" fetch --depth 1 origin "$revision"
        git -C "$name" checkout --detach FETCH_HEAD
    fi
    test "$(git -C "$name" rev-parse HEAD)" = "$revision"
}
fetch_tar yaml-0.2.5.tar.gz https://pyyaml.org/download/libyaml/yaml-0.2.5.tar.gz \
    c642ae9b75fee120b2d96c712538bd2cf283228d2337df2cf2988e3c02678ef4
(
    cd yaml-0.2.5
    CFLAGS="${CFLAGS:-} -fPIC" ./configure --prefix="$prefix" --disable-shared --enable-static
    make -j"$jobs"
    make install
)
fetch_tar zlib-1.3.2.tar.gz https://zlib.net/zlib-1.3.2.tar.gz \
    bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
fetch_git libpng https://github.com/pnggroup/libpng.git cd952f49f95bb27154ae77dbb103032d95f6e580
fetch_git libwebp https://chromium.googlesource.com/webm/libwebp 4fa21912338357f89e4fd51cf2368325b59e9bd9
(
    cd zlib-1.3.2
    # Check the source itself: re-extraction may overwrite a previous patch.
    if ! patch --batch --force --dry-run -R -p1 < "$recipe_dir/patches/zlib-CVE-2026-85091.patch" >/dev/null 2>&1; then
        patch --batch --forward -p1 < "$recipe_dir/patches/zlib-CVE-2026-85091.patch"
    fi
    CFLAGS="${CFLAGS:-} -O2 -fPIC" ./configure --prefix="$prefix" --static
    make -j"$jobs"
    make install
)
cmake -S libpng -B libpng/build-static -DCMAKE_INSTALL_PREFIX="$prefix" -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DCMAKE_BUILD_TYPE=Release -DPNG_SHARED=OFF -DPNG_TESTS=OFF \
    -DZLIB_LIBRARY="$prefix/lib/libz.a" -DZLIB_INCLUDE_DIR="$prefix/include"
cmake --build libpng/build-static -j"$jobs"
cmake --install libpng/build-static
cmake -S libwebp -B libwebp/build-static -DCMAKE_INSTALL_PREFIX="$prefix" -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DWEBP_BUILD_ANIM_UTILS=OFF \
    -DWEBP_BUILD_CWEBP=OFF -DWEBP_BUILD_DWEBP=OFF -DWEBP_BUILD_GIF2WEBP=OFF \
    -DWEBP_BUILD_IMG2WEBP=OFF -DWEBP_BUILD_VWEBP=OFF -DWEBP_BUILD_WEBPINFO=OFF \
    -DWEBP_BUILD_WEBPMUX=OFF -DWEBP_BUILD_EXTRAS=OFF
cmake --build libwebp/build-static -j"$jobs"
cmake --install libwebp/build-static
