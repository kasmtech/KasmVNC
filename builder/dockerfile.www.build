FROM alpine

RUN apk add npm nodejs
RUN apk add bash shadow

ENV SCRIPTS_DIR=/tmp/scripts
COPY builder/scripts $SCRIPTS_DIR

ARG OUTPUT_OWNER_UID
RUN $SCRIPTS_DIR/add-docker-user "$OUTPUT_OWNER_UID"

RUN mkdir -p /src/www && chown "$OUTPUT_OWNER_UID" /src/www
COPY --chown=$OUTPUT_OWNER_UID builder/www-source.tar.gz builder/www-source-revision /src/
RUN tar -xzf /src/www-source.tar.gz -C /src/www
COPY --chown=$OUTPUT_OWNER_UID builder/www-supply-chain.mjs /src/www/.kasm-supply-chain.mjs
COPY --chown=$OUTPUT_OWNER_UID  builder/build-www-inside-docker /src/

WORKDIR /src/www

USER $OUTPUT_OWNER_UID

RUN npm install

ENTRYPOINT [ "/src/build-www-inside-docker" ]
