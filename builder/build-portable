#!/usr/bin/env bash
# Native-architecture portable packages, using glibc 2.28 or musl 1.2.5.
set -euo pipefail
cd "$(dirname "$0")/.."
libc=glibc
ffmpeg_mode=adapters
while [[ $# -gt 0 ]]; do
  case "$1" in
    --libc) [[ $# -ge 2 && $2 =~ ^(glibc|musl)$ ]] || exit 2; libc=$2; shift 2 ;;
    --ffmpeg-mode) [[ $# -ge 2 && $2 =~ ^(adapters|static)$ ]] || exit 2; ffmpeg_mode=$2; shift 2 ;;
    *) echo 'Usage: builder/build-portable [--libc glibc|musl] [--ffmpeg-mode adapters|static]' >&2; exit 2 ;;
  esac
done
profile=portable
[[ "$libc" != musl ]] || profile=portable_musl
test -s builder/www/index.html || { echo 'Run builder/build-www first' >&2; exit 1; }
revision=${KASMVNC_COMMIT_ID:-$(git rev-parse HEAD)}
[[ "$revision" == "$(git rev-parse HEAD)" ]] || { echo "Portable source revision must match HEAD" >&2; exit 1; }
git diff --quiet HEAD -- . || { echo "Commit tracked changes before creating portable source artifacts" >&2; exit 1; }
branch=${CI_COMMIT_REF_NAME:-$(git branch --show-current)}
version=${KASMVNC_PORTABLE_VERSION:-$(.ci/next_release_version "$branch")}
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo 'Invalid release version' >&2; exit 1; }
case $(docker info --format '{{.Architecture}}') in
  x86_64|amd64) arch=amd64 ;;
  aarch64|arm64) arch=arm64 ;;
  *) echo 'Unsupported native Docker architecture' >&2; exit 1 ;;
esac
basename="kasmvncserver_${profile}_${version}_${branch//\//_}_${revision:0:6}_${ffmpeg_mode}_${arch}"
[[ "$basename" =~ ^[a-zA-Z0-9_.+-]+$ ]] || { echo 'Unsafe artifact filename' >&2; exit 1; }
image="kasmvnc-${profile}-builder:${revision:0:12}-${arch}-${ffmpeg_mode}"
build_dir="builder/build/${profile}_${arch}"
log="output/${profile}_${arch}/build.log"
mkdir -p "$build_dir" "output/${profile}_${arch}"
: > "$log"
container=
context_archive=
assembled_context=
gcc_image=
gcc_key=
signing_directory=
signing_volume=
signing_helper=
source builder/musl/signing-volume.sh
finish() {
  local result=$?
  trap - EXIT
  set +e
  [[ -z "$context_archive" ]] || rm -f "$context_archive"
  [[ -z "$assembled_context" ]] || rm -rf "$assembled_context"
  if [[ -n "$container" ]]; then
    docker rm -f "$container" >> "$log" 2>&1
  fi
  cleanup_signing_volume || result=1
  # EXIT runs for failed Docker builds and failed compilation as well as success.
  # Keep the log outside /artifacts so no failed package can be published.
  if ! mkdir -p "output/${profile}_${arch}" || ! cp "$log" "$build_dir/build.log"; then
    echo 'Failed to retain portable build log' >&2
    [[ "$result" != 0 ]] || result=1
  fi
  if [[ "$result" != 0 ]]; then
    echo "Portable build failed (exit $result); last 200 log lines:" >&2
    tail -n 200 "$log" >&2
  fi
  echo "Complete build log: output/${profile}_${arch}/build.log"
  exit "$result"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
run_logged() {
  local phase=$1
  local started=$SECONDS
  shift
  printf '\nPortable build phase: %s\n' "$phase" | tee -a "$log"
  # Retain every byte while keeping the GitLab trace below its output cap.
  # Emit one bounded progress line per minute while compilation produces output.
  "$@" 2>&1 | tee -a "$log" | python3 -u builder/portable/progress.py
  printf 'Portable phase complete: %s (%ss)\n' "$phase" "$((SECONDS - started))" | tee -a "$log"
}
# Resolve each content-keyed image independently; authentication failures never
# trigger rebuilds. Resource groups serialize each architecture's publishers.
prepare_dependency_image() {
  if [[ -n ${CI_REGISTRY_IMAGE:-} ]]; then
    # CI resource_group serializes this check and publish across branches/pipelines.
    reference="$CI_REGISTRY_IMAGE/$cache_repository:${cache_repository}-${arch}-${key}"
    status=0
    resolved=$(python3 builder/portable/dependency-cache.py lookup "$reference") || status=$?
    if [[ $status == 3 ]]; then
      echo "Dependency cache MISS: $cache_repository $arch $key" | tee -a "$log"
      run_logged 'compile dependency image' docker build --pull "${extra_build_args[@]}" --build-arg DEPENDENCY_CONTEXT_SHA="$key" -t "$reference" - < "$context_archive"
      run_logged 'publish dependency image' docker push "$reference"
      resolved=$(python3 builder/portable/dependency-cache.py lookup "$reference")
    elif [[ $status != 0 ]]; then
      echo 'Dependency registry lookup failed; refusing to rebuild on an ambiguous error' >&2
      exit "$status"
    else
      echo "Dependency cache HIT: $cache_repository $arch $key" | tee -a "$log"
    fi
    run_logged 'pull immutable dependency image' docker pull "$resolved"
    image_base=$resolved
  else
    # Local builds use Docker's content-addressed layer cache; no registry writes.
    reference="kasmvnc-$cache_repository:${cache_repository}-${arch}-${key}"
    run_logged 'prepare local dependency image' docker build "${extra_build_args[@]}" --build-arg DEPENDENCY_CONTEXT_SHA="$key" -t "$reference" - < "$context_archive"
    resolved=$(docker image inspect --format '{{.Id}}' "$reference")
    # BuildKit interprets a bare sha256:image-ID as a Docker Hub image name.
    # The local content-keyed tag resolves to the ID recorded in provenance.
    image_base=$reference
  fi
  [[ $(docker image inspect --format '{{index .Config.Labels "org.kasmweb.portable-dependency-key"}}' "$resolved") == "$key" ]] || {
    echo 'Dependency image recipe label mismatch' >&2; exit 1;
  }

}
# git archive omits gitlink contents, including the private functional-test repo.
git archive --format=tar HEAD -o builder/portable/kasmvnc-source.tar
context=builder/scripts/portable-dependencies
inputs=("$context")
[[ "$libc" != glibc ]] || inputs+=(builder/scripts/portable-gcc-runtime)
[[ "$libc" != musl ]] || inputs+=(builder/musl/dependencies)
[[ -z $(git ls-files --others -- "${inputs[@]}") ]] || {
  echo 'Dependency context contains untracked or ignored files; remove or commit them first' >&2
  exit 1
}
cache_repository=portable-deps
packaging_dockerfile=builder/portable/Dockerfile
entrypoint=/src/builder/portable/build-inside-docker
extra_build_args=()
if [[ -n ${CI_REGISTRY_IMAGE:-} ]]; then
  : "${CI_REGISTRY_USER:?}" "${CI_REGISTRY_PASSWORD:?}" "${CI_REGISTRY:?}"
  printf '%s' "$CI_REGISTRY_PASSWORD" | docker login "$CI_REGISTRY" --username "$CI_REGISTRY_USER" --password-stdin >> "$log" 2>&1
fi
if [[ "$libc" == glibc ]]; then
  context=builder/scripts/portable-gcc-runtime
  cache_repository=portable-gcc-runtime
  key=$(python3 builder/portable/dependency-cache.py key "$context" "$arch")
  context_archive="$build_dir/gcc-runtime-context.tar"
  python3 builder/portable/dependency-cache.py archive "$context" "$context_archive"
  prepare_dependency_image
  rm -f "$context_archive"
  gcc_image=$resolved
  gcc_key=$key
  extra_build_args=(--build-arg "GCC_RUNTIME_IMAGE=$image_base")
  # Parent identity is part of the dependency key, including the immutable digest
  # so rebuilding an expired toolchain tag cannot reuse a stale child image.
  assembled_context=$(mktemp -d /tmp/kasm-glibc-dependencies.XXXXXX)
  cp -a builder/scripts/portable-dependencies/. "$assembled_context/"
  printf '%s\n' "$gcc_image" > "$assembled_context/gcc-runtime-image.txt"
  printf '%s\n' "$gcc_key" > "$assembled_context/gcc-runtime-key.txt"
  context=$assembled_context
  cache_repository=portable-deps
fi
if [[ "$libc" == musl ]]; then
  # Docker can see only this assembled context. Hash every shared recipe and
  # musl-only dependency input; application/packaging edits do not invalidate it.
  assembled_context=$(mktemp -d /tmp/kasm-musl-dependencies.XXXXXX)
  cp -a "$context" "$assembled_context/recipes"
  cp -a builder/musl/dependencies "$assembled_context/musl"
  cp builder/musl/dependencies/Dockerfile "$assembled_context/Dockerfile"
  context=$assembled_context
  cache_repository=portable-musl-deps
  packaging_dockerfile=builder/musl/Dockerfile
  entrypoint=/src/builder/musl/build-inside-docker
fi
key=$(python3 builder/portable/dependency-cache.py key "$context" "$arch")
# Normalize Git-tracked executable modes and ownership before Docker sees the
# context; runner checkout umask must not change either the key or image inputs.
context_archive="$build_dir/dependency-context.tar"
python3 builder/portable/dependency-cache.py archive "$context" "$context_archive"
prepare_dependency_image
printf '%s\n' "$resolved" > "$build_dir/dependency-image.txt"
run_logged 'create packaging image' docker build -f "$packaging_dockerfile" --build-arg BUILD_JOBS="${BUILD_JOBS:-8}" --build-arg BUILDER_IMAGE="$image_base" --build-arg KASMVNC_FFMPEG_MODE="$ffmpeg_mode" -t "${image}-package" .
signing_environment=()
if [[ "$libc" == musl ]]; then
  builder/musl/test-signing-volume "${image}-package"
  prepare_signing_volume "${image}-package"
  signing_environment=(--mount "type=volume,src=$signing_volume,dst=/run/kasm-signing,readonly"
    -e KASMVNC_APK_KEYS_DIR=/run/kasm-signing)
fi
container=$(docker create --entrypoint "$entrypoint" \
  "${signing_environment[@]}" -e KASMVNC_LIBC="$libc" -e KASMVNC_FFMPEG_MODE="$ffmpeg_mode" \
  -e KASMVNC_DEPENDENCY_IMAGE="$resolved" -e KASMVNC_DEPENDENCY_KEY="$key" \
  -e KASMVNC_GCC_RUNTIME_IMAGE="$gcc_image" -e KASMVNC_GCC_RUNTIME_KEY="$gcc_key" \
  -e KASMVNC_COMMIT_ID="$revision" -e KASMVNC_PORTABLE_VERSION="$version" \
  -e KASMVNC_PORTABLE_BASENAME="$basename" -e BUILD_JOBS="${BUILD_JOBS:-8}" \
  "${image}-package" 2>> "$log")
run_logged 'compile and package native binaries' docker start -a "$container"
result=$(docker inspect -f '{{.State.ExitCode}}' "$container" 2>> "$log")
[[ "$result" == 0 ]] || exit "$result"
run_logged 'export verified packages' docker cp "$container:/artifacts/." "$build_dir/"
